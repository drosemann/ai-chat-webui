# Port for the local Express server
PORT=3000

# Ollama API endpoint (default local Ollama server)
OLLAMA_API_URL=http://localhost:11434/api/generate

# Default model used when requests do not specify one
OLLAMA_MODEL=qwen2.5:0.5b

# Self-hosted Supabase backend (see supabase/README.md).
# The anon key is public by design; RLS protects user data.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
# Server-only: identical to JWT_SECRET in supabase/.env. Never expose to browsers.
SUPABASE_JWT_SECRET=
# Optional extra CORS origins (exact match, e.g. your public app URL).
SITE_URL=
APP_PUBLIC_URL=

# Allowed browser origin for the API (default http://localhost:PORT).
ALLOWED_ORIGIN=

# Set to production when serving over HTTPS.
NODE_ENV=
