# Supabase stack configuration (copy to supabase/.env, never commit the copy).
#
# Generate secrets with:
#   openssl rand -hex 32            # POSTGRES_PASSWORD
#   openssl rand -base64 48 | tr -d '\n'   # JWT_SECRET (at least 32 characters)
#
# The anon key is a public client key. RLS is what protects user data.
# The service_role key (if you generate one) is server-only and must never
# be placed in browser-served files.

# --- Images (pin exact digests after your first successful deploy) ---
POSTGRES_IMAGE=supabase/postgres:15.8.1.085
GOTRUE_IMAGE=supabase/gotrue:v2.197.0
POSTGREST_IMAGE=postgrest/postgrest:v12.2.3
GATEWAY_IMAGE=caddy:2-alpine

# --- Postgres ---
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-me-postgres-password-min-32-chars-long-please
POSTGRES_PORT=5432

# --- Network ---
# Bind to localhost and put a real reverse proxy with TLS in front for production.
BIND_ADDR=127.0.0.1
SUPABASE_PORT=8000

# --- Public URLs ---
# What browsers use for Auth + PostgREST (served by the gateway service).
SUPABASE_PUBLIC_URL=http://localhost:8000
# Full external Auth URL used for OAuth callbacks and email links.
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Public URL of this Node app (used for Auth redirect allow-listing and email links).
SITE_URL=http://localhost:3000
# Optional extra comma-separated redirect URLs (staging domains, LAN addresses).
APP_EXTRA_REDIRECT_URLS=

# --- Auth ---
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long-please
GOTRUE_JWT_EXP=3600
# Set false until real SMTP is configured; true skips email confirmation.
GOTRUE_MAILER_AUTOCONFIRM=false

# --- SMTP (required for confirmation + password-reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=AI Chat WebUI
SMTP_MAX_FREQUENCY=1s

# --- Component ports (localhost only) ---
GOTRUE_PORT=9999
POSTGREST_PORT=3001
